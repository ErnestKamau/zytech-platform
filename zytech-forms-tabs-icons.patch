diff --git a/resources/css/website/components/icons.css b/resources/css/website/components/icons.css
index 8eb2a5c..6229390 100644
--- a/resources/css/website/components/icons.css
+++ b/resources/css/website/components/icons.css
@@ -95,6 +95,40 @@ .zy-icon-tile--slate {
    directly where a tile sits inside an <a>/<button>. */
 .zy-icon-tile--interactive:hover {
     transform: translateY(-2px);
+    box-shadow: var(--zy-shadow-glow-sky);
+}
+
+/* Ring variant — outlined instead of filled, for denser layouts (nav
+   items, list rows) where a solid tile would be too heavy. Gains the
+   filled gradient only on hover, so the "premium moment" is earned by
+   interaction rather than shown at rest everywhere. */
+.zy-icon-tile--ring {
+    background: transparent;
+    box-shadow: inset 0 0 0 1.5px var(--zy-color-border);
+    color: var(--zy-slate-500);
+    transition: background var(--zy-duration-base) var(--zy-ease),
+        box-shadow var(--zy-duration-base) var(--zy-ease),
+        color var(--zy-duration-base) var(--zy-ease);
+}
+
+.zy-icon-tile--ring:hover {
+    background: var(--zy-gradient-brand);
+    box-shadow: var(--zy-shadow-glow-sky);
+    color: #fff;
+}
+
+/* Restrained rotate — for refresh/settings-type icons only, never applied
+   by default. Add alongside .zy-icon on the specific icon, nested inside
+   a .zy-btn, .zy-icon-btn, or .zy-icon-tile--interactive so it only
+   triggers on a real interactive parent. */
+.zy-icon--spin-hover {
+    transition: transform var(--zy-duration-slow) var(--zy-ease);
+}
+
+.zy-btn:hover .zy-icon--spin-hover,
+.zy-icon-btn:hover .zy-icon--spin-hover,
+.zy-icon-tile--interactive:hover .zy-icon--spin-hover {
+    transform: rotate(90deg);
 }
 
