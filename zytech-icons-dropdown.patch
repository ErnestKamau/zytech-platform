diff --git a/resources/css/website/components/icons.css b/resources/css/website/components/icons.css
index 3dc32f1..8eb2a5c 100644
--- a/resources/css/website/components/icons.css
+++ b/resources/css/website/components/icons.css
@@ -9,6 +9,7 @@ .zy-icon {
     height: 1.5rem;
     stroke-width: 1.5;
     color: inherit;
+    transition: color var(--zy-duration-fast) var(--zy-ease), transform var(--zy-duration-fast) var(--zy-ease);
 }
 
 .zy-icon--sm {
@@ -30,3 +31,111 @@ .zy-icon svg {
     width: 100%;
     height: 100%;
 }
+
+/**
+ * Icon tiles — a housed icon for feature lists, service cards, statistic
+ * cards. This is the piece that was missing: on their own, Heroicons at
+ * 24px sitting directly on white read as an afterthought. A tile gives
+ * every icon a consistent footprint and a single deliberate surface.
+ */
+.zy-icon-tile {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    flex-shrink: 0;
+    width: 2.75rem;
+    height: 2.75rem;
+    border-radius: var(--zy-radius-md);
+    background: var(--zy-sky-50);
+    color: var(--zy-color-primary);
+    transition: transform var(--zy-duration-base) var(--zy-ease), box-shadow var(--zy-duration-base) var(--zy-ease);
+}
+
+.zy-icon-tile .zy-icon {
+    width: 1.375rem;
+    height: 1.375rem;
+}
+
+.zy-icon-tile--sm {
+    width: 2.25rem;
+    height: 2.25rem;
+}
+
+.zy-icon-tile--sm .zy-icon {
+    width: 1.125rem;
+    height: 1.125rem;
+}
+
+.zy-icon-tile--lg {
+    width: 3.5rem;
+    height: 3.5rem;
+    border-radius: var(--zy-radius-lg);
+}
+
+.zy-icon-tile--lg .zy-icon {
+    width: 1.75rem;
+    height: 1.75rem;
+}
+
+/* Reserve the gradient fill for one tile per view — a genuine featured
+   moment, not a default state for every icon on the page. */
+.zy-icon-tile--gradient {
+    background: var(--zy-gradient-brand);
+    color: #fff;
+    box-shadow: var(--zy-shadow-glow-sky);
+}
+
+.zy-icon-tile--slate {
+    background: var(--zy-slate-100);
+    color: var(--zy-slate-600);
+}
+
+/* Lift the tile when its containing card is hovered/interactive — pair
+   with .zy-card--interactive:hover .zy-icon-tile in cards.css, or apply
+   directly where a tile sits inside an <a>/<button>. */
+.zy-icon-tile--interactive:hover {
+    transform: translateY(-2px);
+}
+
+/**
+ * Icon-only button — ghost circular control for triggers, close buttons,
+ * and toolbar actions. Distinct from .zy-btn, which always carries text.
+ */
+.zy-icon-btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 2.25rem;
+    height: 2.25rem;
+    border-radius: var(--zy-radius-full);
+    border: 1px solid transparent;
+    background: transparent;
+    color: var(--zy-slate-500);
+    cursor: pointer;
+    transition: background var(--zy-duration-fast) var(--zy-ease),
+        color var(--zy-duration-fast) var(--zy-ease),
+        transform var(--zy-duration-fast) var(--zy-ease);
+}
+
+.zy-icon-btn:hover {
+    background: var(--zy-slate-100);
+    color: var(--zy-color-ink);
+}
+
+.zy-icon-btn:active {
+    transform: scale(0.94);
+}
+
+.zy-icon-btn:focus-visible {
+    outline: none;
+    box-shadow: var(--zy-focus-ring);
+}
+
+.zy-icon-btn--frost {
+    color: rgb(255 255 255 / 0.85);
+}
+
+.zy-icon-btn--frost:hover {
+    background: var(--zy-frost-bg);
+    color: #fff;
+}
diff --git a/resources/css/website/utilities/helpers.css b/resources/css/website/utilities/helpers.css
index 310c29b..27b53ad 100644
--- a/resources/css/website/utilities/helpers.css
+++ b/resources/css/website/utilities/helpers.css
@@ -29,3 +29,22 @@ .text-left {
 .text-right {
     text-align: right;
 }
+
+/**
+ * Alpine transition utilities — scale+fade from the trigger corner.
+ * Used by dropdown/popover-style menus (x-transition:enter="zy-transition-fast"
+ * etc.) so the entrance reads as deliberate rather than a flat opacity toggle.
+ */
+.zy-transition-fast {
+    transition: opacity var(--zy-duration-fast) var(--zy-ease), transform var(--zy-duration-fast) var(--zy-ease);
+}
+
+.zy-transition-scale-start {
+    opacity: 0;
+    transform: scale(0.96) translateY(-4px);
+}
+
+.zy-transition-scale-end {
+    opacity: 1;
+    transform: scale(1) translateY(0);
+}
